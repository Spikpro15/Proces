<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090C10">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_pill_bg"
                android:paddingLeft="12dp"
                android:paddingTop="5dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp"
                android:text="○ Ожидание ПК по USB..."
                android:textColor="#D29922"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGameName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingRight="6dp"
                android:text=""
                android:textColor="#8B949E"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnMacros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_pill_bg"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:text="⚡ Кнопки"
                android:textColor="#E6EDF3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_pill_bg"
                android:paddingLeft="9dp"
                android:paddingTop="5dp"
                android:paddingRight="9dp"
                android:paddingBottom="5dp"
                android:text="☀"
                android:textColor="#C9D1D9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnRotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_pill_bg"
                android:paddingLeft="9dp"
                android:paddingTop="5dp"
                android:paddingRight="9dp"
                android:paddingBottom="5dp"
                android:text="⟳"
                android:textColor="#C9D1D9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_pill_bg"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:text="⚙"
                android:textColor="#E6EDF3"
                android:textSize="14sp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/metricsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="false" />

        <TextView
            android:id="@+id/tvMiniMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:text="⌃ Свайп вверх — плеер · ⇠ Свайп влево — кнопки"
            android:textColor="#6E7681"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Swipe-Up Windows Media Player Overlay -->
    <LinearLayout
        android:id="@+id/mediaOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B0F15"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnCloseMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_pill_bg"
            android:paddingLeft="16dp"
            android:paddingTop="5dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:text="⌄ Свайп вниз — вернуться"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMediaArt"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/card_bg"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMediaStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Плеер Windows"
                    android:textColor="#58A6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMediaTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Ничего не играет"
                    android:textColor="#E6EDF3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMediaArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#8B949E"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="72dp"
                android:layout_height="58dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:text="⏮"
                android:textColor="#E6EDF3"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/btnPlayPause"
                android:layout_width="90dp"
                android:layout_height="66dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:text="⏯"
                android:textColor="#58A6FF"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="72dp"
                android:layout_height="58dp"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:text="⏭"
                android:textColor="#E6EDF3"
                android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVolDown"
                android:layout_width="68dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/status_pill_bg"
                android:gravity="center"
                android:text="🔉 −"
                android:textColor="#C9D1D9"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnVolMute"
                android:layout_width="54dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/status_pill_bg"
                android:gravity="center"
                android:text="🔇"
                android:textColor="#C9D1D9"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnVolUp"
                android:layout_width="68dp"
                android:layout_height="40dp"
                android:background="@drawable/status_pill_bg"
                android:gravity="center"
                android:text="🔊 +"
                android:textColor="#C9D1D9"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Swipe-Left Stream Deck Macro Panel -->
    <LinearLayout
        android:id="@+id/macroOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5090C10"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Быстрые кнопки ПК / OBS"
                android:textColor="#E6EDF3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseMacros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_pill_bg"
                android:paddingLeft="14dp"
                android:paddingTop="5dp"
                android:paddingRight="14dp"
                android:paddingBottom="5dp"
                android:text="✕ Закрыть (свайп вправо)"
                android:textColor="#8B949E"
                android:textSize="12sp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/macroGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="false" />
    </LinearLayout>
</FrameLayout>
